APP_NAME=TopUpMarket
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_topup_market
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
# sync = langsung; database = perlu `php artisan queue:work` (produksi).
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Mail (SMTP)
# ---------------------------------------------------------------------------
# Lokal  : Mailhog (port 1025) atau Mailtrap.
# Produksi: pakai SMTP provider (Mailtrap / Mailgun / Postmark / Gmail).
#
# Contoh Mailtrap sandbox:
#   MAIL_MAILER=smtp
#   MAIL_HOST=sandbox.smtp.mailtrap.io
#   MAIL_PORT=2525
#   MAIL_USERNAME=<user>
#   MAIL_PASSWORD=<pass>
#   MAIL_ENCRYPTION=tls
#
# Contoh Gmail (butuh App Password):
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USERNAME=kamu@gmail.com
#   MAIL_PASSWORD=<app-password-16-digit>
#   MAIL_ENCRYPTION=tls
#
# MAIL_MAILER=log  -> email ditulis ke storage/logs (tanpa kirim, untuk uji coba).
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@topupmarket.test"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Payment Gateway
# ---------------------------------------------------------------------------
# simulation = pembayaran simulasi (tanpa jaringan), cocok untuk demo/testing.
# midtrans   = Midtrans Snap (sandbox/production) + webhook terverifikasi.
PAYMENT_DRIVER=simulation

# Kebijakan verifikasi pembayaran (siapa yang menyelesaikan pesanan):
# hybrid = ada bukti pembayaran -> otomatis Selesai; tanpa bukti -> menunggu admin.
# manual = selalu menunggu verifikasi admin (paling aman untuk toko sungguhan).
# auto   = setiap klaim "sudah bayar" -> otomatis Selesai.
PAYMENT_VERIFICATION=hybrid

# Isi bila PAYMENT_DRIVER=midtrans (ambil dari dashboard Midtrans).
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
